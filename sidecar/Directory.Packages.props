<Project>
  <PropertyGroup>
    <!-- Transitive pins override vulnerable versions pulled in by drivers/SMO (§13 rule 10). -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <!-- Pins follow docs/ARCHITECTURE.md §2; upgrade only at milestone boundaries. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="6.1.7" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="180.140.0" />
    <PackageVersion Include="Microsoft.SqlServer.SqlManagementObjects" Version="181.37.1" />
    <PackageVersion Include="Apache.Arrow" Version="23.0.0" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <!-- Phase D1: called directly by the SQLite provider (authorizer, defensive config, attach limit, interrupt); the
         version Microsoft.Data.Sqlite 10.0.13 brings (bundled SQLite 3.53.3), pinned explicitly. -->
    <PackageVersion Include="SQLitePCLRaw.core" Version="2.1.13" />
    <PackageVersion Include="StreamJsonRpc" Version="2.26.150" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- SSH tunnels (§2): MIT; pulls BouncyCastle.Cryptography (MIT) for ed25519 and modern ciphers. -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <!-- Phase D2: MySQL / MariaDB driver (MIT, managed, async, trimmable); local-infile stays off on every connection. -->
    <PackageVersion Include="MySqlConnector" Version="2.6.2" />
    <!-- Phase D3: DuckDB (MIT) with its native library (DuckDB 1.5.6, EOL 2027-03-01) through DuckDB.NET.Bindings.Full
         1.5.6.1; needs Apache.Arrow >= 23.0.0. No IsTrimmable metadata, so the Host roots it. -->
    <PackageVersion Include="DuckDB.NET.Data.Full" Version="1.5.6.1" />
    <!-- Phase D4 (hidden engine): ODP.NET Core, one managed assembly; Oracle Free Distribution, Hosting, and Use Terms —
         redistributed unmodified only, so the Host roots it untrimmed. Its MIT-Kerberos and other notices are carried in
         THIRD-PARTY-NOTICES.md. 23.26.400 (published 2026-10-20). -->
    <PackageVersion Include="Oracle.ManagedDataAccess.Core" Version="23.26.400" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>
</Project>
