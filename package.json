{
  "name": "querithm",
  "private": true,
  "version": "0.1.0",
  "description": "Querithm — a cross-platform SQL IDE for SQL Server, PostgreSQL, MySQL / MariaDB, SQLite and DuckDB",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/run.mjs build-sidecar --debug && tauri dev",
    "build": "node scripts/run.mjs build-sidecar --release && node scripts/gen-notices.mjs && tauri build",
    "dev:web": "vite",
    "dev:bridge": "node scripts/dev-bridge.mjs",
    "build:web": "tsc -b && vite build",
    "build:sidecar": "node scripts/run.mjs build-sidecar --debug",
    "test": "vitest run && dotnet test sidecar",
    "test:web": "vitest run",
    "coverage:web": "vitest run --coverage",
    "typecheck": "tsc -b --noEmit",
    "gen:contract": "node scripts/run.mjs gen-contract",
    "bench": "node scripts/bench/run.mjs",
    "tauri": "tauri",
    "offline:prepare": "bash scripts/offline-prepare.sh",
    "notices": "node scripts/gen-notices.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@glideapps/glide-data-grid": "6.0.3",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "@tauri-apps/plugin-fs": "2.7.1",
    "@xyflow/react": "12.12.0",
    "apache-arrow": "18.1.0",
    "dockview": "4.13.1",
    "lodash": "4.18.1",
    "marked": "4.3.0",
    "monaco-editor": "0.52.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-responsive-carousel": "3.2.23",
    "sql-formatter": "15.9.0",
    "uplot": "1.6.32",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "3.2.7",
    "jsdom": "^30.1.3",
    "puppeteer-core": "25.14.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "6.4.4",
    "vitest": "3.2.7",
    "ws": "8.22.0"
  },
  "packageManager": "pnpm@12.14.0"
}
